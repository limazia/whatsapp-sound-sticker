{
  "name": "whatsapp-sound-sticker",
  "version": "1.0.0",
  "description": "API para criar e enviar figurinhas com som no WhatsApp",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "author": "acacio (https://x.com/limadeacacio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limazia/whatsapp-sound-sticker.git"
  },
  "bugs": {
    "url": "https://github.com/limazia/whatsapp-sound-sticker/issues"
  },
  "homepage": "https://github.com/limazia/whatsapp-sound-sticker#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.app.json && tsc --noEmit -p web/tsconfig.node.json",
    "dev": "tsx watch --include .env src/server.ts",
    "test": "vitest run",
    "compose": "docker compose -f docker-compose.yaml up -d",
    "start": "node --enable-source-maps dist/server.js",
    "setup": "yarn install --frozen-lockfile --ignore-scripts && yarn fetch-ffmpeg && yarn build",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.ts",
    "offline-test": "node --import tsx scripts/offline-test.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "cd web && eslint src"
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/sse": "^0.6.2",
    "@fastify/static": "^10.0.0",
    "@fastify/swagger": "^9.9.0",
    "@scalar/fastify-api-reference": "^1.83.0",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "dotenv-expand": "^1000.0.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "ffmpeg-static": "5.3.0",
    "plogme": "2.2.11",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "private": true
}
